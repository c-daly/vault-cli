# Vault CLI configuration
# Copy to ~/.config/vault-cli/config and edit

# Path to your Obsidian vault (required)
VAULT_DIR="~/projects/vault"

# Editor to use (defaults to $EDITOR or nvim)
# VAULT_EDITOR="nvim"

# Recap: where to scan for git repos (colon-separated for multiple dirs)
# VAULT_REPOS_DIR="$HOME/projects"

# Recap: enable Google Calendar integration (requires gcalcli)
# VAULT_GCAL_ENABLED="true"

# Recap/harvest source roots. Both are colon-separated and skip roots that
# don't exist, so one config can be shared across machines.
#
# Set these on a WSL install that also does Windows-side work: repos under
# C:\Users\<user> and sessions started from PowerShell are invisible to the
# defaults, which only see $HOME.
# VAULT_REPOS_DIR="$HOME/projects:/mnt/c/Users/<user>"
# VAULT_CLAUDE_DIRS="$HOME/.claude/projects:/mnt/c/Users/<user>/.claude/projects"

# Daily narrative (LLM diary summary; NARRATE=0 disables)
NARRATE=1
NARRATE_MODEL="haiku"
# NARRATE_TIMEOUT=60

# The narrator shells out to `claude -p`, which leaves a session transcript like
# any other run. It is run from this directory so those transcripts land in one
# predictable Claude project dir that `harvest` skips — otherwise the summarizer's
# own output is ingested as if it were your work.
# VAULT_NARRATE_CWD="${TMPDIR:-/tmp}/vault-cli-narrate"

# Gmail IMAP socket timeout, seconds. Without it a blackholed connection hangs
# the whole recap instead of degrading to the "unavailable" note.
# GMAIL_TIMEOUT=20

# Gmail diary source: app-password IMAP; leave empty to disable
VAULT_GMAIL_USER=""
VAULT_GMAIL_APP_PASSWORD=""

# Event log: an append-only JSONL record written alongside the markdown notes by
# `harvest` and `recap`. Defaults to $VAULT_DIR/events, so it rides the existing
# `vault sync` with no extra plumbing. Point it elsewhere to keep it out of the
# vault, or set VAULT_NO_EVENTS=1 to write notes without touching the log.
# VAULT_EVENTS_DIR="$VAULT_DIR/events"
# VAULT_NO_EVENTS=1
